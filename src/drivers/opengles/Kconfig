config LV_USE_OPENGLES
	bool "OpenGL ES"
	select LV_USE_MATRIX
	default n
	help
		Generic OpenGL ES display driver, for embedding LVGL in another application or driving it through GLFW/EGL.

if LV_USE_OPENGLES

config LV_USE_OPENGLES_DEBUG
	bool "Debug mode"
	default n
	help
		Check for an OpenGL error after every GL call and log it with the call site.


endif # LV_USE_OPENGLES

config LV_USE_EGL
	bool
	default n

# Promptless as it's not part of the public API
config LV_USE_OPENGLES_PBUFFER
	bool
	default n
	depends on LV_USE_DRAW_NANOVG
	select LV_USE_EGL
	select LV_USE_OPENGLES
	help
		Render on the GPU into an off-screen EGL pbuffer with no window system at
		all, and read the frame back into the display's draw buffer. For headless
		rendering, screenshot testing and server-side image generation.

config LV_USE_GLFW
	bool "GLFW"
	default n
	select LV_USE_OPENGLES
	depends on !LV_USE_EGL
	help
		Open a window on a PC desktop with GLFW and read mouse and keyboard input.

