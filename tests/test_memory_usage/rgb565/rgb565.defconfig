# A size conscious but realistic product configuration: an RGB565 panel, and only the
# software renderer colour formats such a product actually needs.
#
# LVGL enables every LV_DRAW_SW_SUPPORT_* by default, and a product that never sees those
# formats still pays for them. This configuration exists so the cost of that default, and any
# regression that only shows up once it is tuned away, stays visible next to `standard`.
CONFIG_LV_USE_DEMO_WIDGETS=y

CONFIG_LV_DRAW_SW_SUPPORT_RGB565=y
CONFIG_LV_DRAW_SW_SUPPORT_RGB565A8=y
CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888=y
CONFIG_LV_DRAW_SW_SUPPORT_A8=y

# CONFIG_LV_DRAW_SW_SUPPORT_RGB565_SWAPPED is not set
# CONFIG_LV_DRAW_SW_SUPPORT_RGB888 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_XRGB8888 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888_PREMULTIPLIED is not set
# CONFIG_LV_DRAW_SW_SUPPORT_L8 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_AL88 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_I1 is not set
