config LV_DPI_DEF
	default LV_Z_DPI_DEF if LV_Z_DPI_DEF != 0

config LV_DRAW_BUF_ALIGN
	default LV_Z_DRAW_BUF_ALIGN if LV_Z_DRAW_BUF_ALIGN != 0

choice LV_COLOR_FORMAT_DEFAULT
	default LV_COLOR_FORMAT_I1 if LV_Z_COLOR_FORMAT_I1
	default LV_COLOR_FORMAT_L8 if LV_Z_COLOR_FORMAT_L8
	default LV_COLOR_FORMAT_RGB565 if LV_Z_COLOR_FORMAT_RGB565
	default LV_COLOR_FORMAT_RGB565_SWAPPED if LV_Z_COLOR_FORMAT_RGB565_SWAPPED
	default LV_COLOR_FORMAT_RGB888 if LV_Z_COLOR_FORMAT_RGB888
	default LV_COLOR_FORMAT_XRGB8888 if LV_Z_COLOR_FORMAT_XRGB8888
	default LV_COLOR_FORMAT_ARGB8888 if LV_Z_COLOR_FORMAT_ARGB8888
endchoice

config LV_USE_DRAW_DMA2D
	default y if LV_Z_DRAW_DMA2D_DEFAULT

config LV_USE_DRAW_DMA2D_INTERRUPT
	default y if LV_Z_DRAW_DMA2D_INTERRUPT

config LV_DRAW_DMA2D_HAL_INCLUDE
	default LV_Z_DRAW_DMA2D_HAL_INCLUDE if LV_Z_DRAW_DMA2D_HAL_INCLUDE != ""

config LV_NEMA_USE_CACHE
	default y if LV_Z_NEMA_USE_CACHE

config LV_NEMA_CACHE_HAL_INCLUDE
	default LV_Z_NEMA_CACHE_HAL_INCLUDE if LV_Z_NEMA_CACHE_HAL_INCLUDE != ""

choice LV_USE_NEMA_LIB
	default LV_NEMA_LIB_M33_REVC if LV_Z_NEMA_LIB_M33_REVC
	default LV_NEMA_LIB_M33_NEMAPVG if LV_Z_NEMA_LIB_M33_NEMAPVG
	default LV_NEMA_LIB_M55 if LV_Z_NEMA_LIB_M55
	default LV_NEMA_LIB_M7 if LV_Z_NEMA_LIB_M7
endchoice

config LV_Z_DRAW_DMA2D
	default y if LV_USE_DRAW_DMA2D

config LV_Z_DRAW_DAVE2D
	default y if LV_USE_DRAW_DAVE2D

config LV_Z_DRAW_PXP
	default y if LV_USE_DRAW_PXP

config LV_Z_USE_NEMA_GFX
	default y if LV_USE_NEMA_GFX

config LV_Z_NEMA_HAL_CUSTOM
	default y if LV_USE_NEMA_GFX && LV_NEMA_HAL_CUSTOM
