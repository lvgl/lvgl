# NemaGFX STM32 HAL IRQ provider: the GPU2D command-list completion delivered
# by the STM32 HAL.

config LV_IRQ_PROVIDER_NEMA_STM32
	int
	default 3

choice LV_IRQ_DEFAULT_PROVIDER
	config LV_IRQ_DEFAULT_PROVIDER_NEMA_STM32
		bool "NemaGFX STM32 HAL"
		depends on LV_USE_NEMA_GFX && LV_NEMA_HAL_STM32
endchoice

choice LV_IRQ_NEMA_GPU2D_PROVIDER_CHOICE
	config LV_IRQ_NEMA_GPU2D_PROVIDER_NEMA_STM32
		bool "NemaGFX STM32 HAL"
		depends on LV_USE_NEMA_GFX && LV_NEMA_HAL_STM32
endchoice

config LV_IRQ_NEMA_GPU2D_PROVIDER
	int
	default LV_IRQ_PROVIDER_NEMA_STM32 if LV_IRQ_NEMA_GPU2D_PROVIDER_NEMA_STM32 || (LV_IRQ_NEMA_GPU2D_PROVIDER_DEFAULT && LV_IRQ_DEFAULT_PROVIDER_NEMA_STM32)
